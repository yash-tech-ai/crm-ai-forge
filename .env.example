# ── Database ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_ai_forge"

# ── Redis ──
REDIS_URL="redis://localhost:6379"

# ── Auth ──
JWT_SECRET="change-me-to-a-secure-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-to-another-secure-secret-min-32"
NEXTAUTH_SECRET="change-me-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── API ──
API_URL="http://localhost:3001"
API_PORT=3001

# ── Email (Amazon SES or SMTP) ──
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your-sendgrid-api-key"
DEFAULT_FROM_EMAIL="noreply@yourdomain.com"
DEFAULT_FROM_NAME="CRM AI Forge"

# ── MinIO (S3-compatible file storage) ──
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="crm-ai-forge"

# ── OpenClaw ──
OPENCLAW_API_URL="http://localhost:8484"
OPENCLAW_WEBHOOK_SECRET="your-webhook-secret"

# ── AI Providers ──
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."

# ── App ──
NODE_ENV="development"
LOG_LEVEL="debug"
